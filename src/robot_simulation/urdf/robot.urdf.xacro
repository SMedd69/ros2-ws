<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">

    <!-- ================================================== -->
    <!-- Dimensions générales du robot                     -->
    <!-- ================================================== -->
    <xacro:property name="base_length" value="0.40"/>
    <xacro:property name="base_width"  value="0.30"/>
    <xacro:property name="base_height" value="0.12"/>

    <!-- Position du centre du châssis -->
    <xacro:property name="base_z" value="0.11"/>

    <!-- ================================================== -->
    <!-- Roues arrière                                     -->
    <!-- ================================================== -->
    <xacro:property name="wheel_radius" value="0.05"/>
    <xacro:property name="wheel_width"  value="0.03"/>

    <!-- Position des roues -->
    <xacro:property name="wheel_x" value="-0.10"/>
    <xacro:property name="wheel_y" value="0.165"/>
    <xacro:property name="wheel_z" value="-0.08"/>

    <!-- ================================================== -->
    <!-- Roue directrice avant                             -->
    <!-- ================================================== -->
    <xacro:property name="caster_radius" value="0.04"/>
    <xacro:property name="caster_width"  value="0.03"/>

    <xacro:property name="caster_x" value="0.18"/>
    <xacro:property name="caster_z" value="-0.1"/>

    <!-- ================================================== -->
    <!-- CHÂSSIS                                           -->
    <!-- ================================================== -->
    <link name="base_link">
        <!-- Visualisation -->
        <visual>
            <origin xyz="0 0 0"/>

            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>

            <material name="base_color">
                <color rgba="1.0 0.0 0.6 1.0"/>
            </material>

        </visual>

        <!-- Collision -->
        <collision>
            <origin xyz="0 0 0"/>

            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
        </collision>

        <!-- Physique -->
        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="5.0"/>

            <inertia
                ixx="0.045"
                ixy="0.0"
                ixz="0.0"
                iyy="0.071"
                iyz="0.0"
                izz="0.092"/>
        </inertial>
    </link>

    <!-- ================================================== -->
    <!-- ROUE ARRIÈRE GAUCHE                               -->
    <!-- ================================================== -->
    <link name="left_wheel">
        <visual>

            <!-- Le cylindre tourne autour de Y -->
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>

            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}" />
            </geometry>

            <material name="left_wheel_color">
                <color rgba="0.6 0.0 1.0 1.0"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}" />
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="0.5"/>

            <inertia
                ixx="0.0008"
                ixy="0.0"
                ixz="0.0"
                iyy="0.0008"
                iyz="0.0"
                izz="0.0008"/>
        </inertial>
    </link>

    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>

        <origin xyz="${wheel_x} ${wheel_y} ${wheel_z}" rpy="0 0 0"/>

        <!-- Axe de rotation de la roue -->
        <axis xyz="0 1 0"/>
    </joint>

    <!-- ================================================== -->
    <!-- ROUE ARRIÈRE DROITE                               -->
    <!-- ================================================== -->
    <link name="right_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>

            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}" />
            </geometry>

            <material name="right_wheel_color">
                <color rgba="0.6 0.0 1.0 1.0"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>

            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="0.5"/>

            <inertia
                ixx="0.0008"
                ixy="0.0"
                ixz="0.0"
                iyy="0.0008"
                iyz="0.0"
                izz="0.0008"/>
        </inertial>
    </link>

    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>

        <origin xyz="${wheel_x} ${-wheel_y} ${wheel_z}" rpy="0 0 0"/>

        <axis xyz="0 1 0"/>
    </joint>

    <!-- ================================================== -->
    <!-- ROUE DIRECTRICE AVANT                             -->
    <!-- ================================================== -->
    <link name="front_caster">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>

            <geometry>
                <cylinder radius="${caster_radius}" length="${caster_width}" />
            </geometry>

            <material name="front_caster_color">
                <color rgba="0.2 1.0 0.0 1.0"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>

            <geometry>
                <cylinder radius="${caster_radius}" length="${caster_width}"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="0.2"/>
            <inertia
                ixx="0.0003"
                ixy="0.0"
                ixz="0.0"
                iyy="0.0003"
                iyz="0.0"
                izz="0.0003"/>
        </inertial>
    </link>


    <joint name="front_caster_joint" type="continuous">
        <parent link="base_link"/>
        <child link="front_caster"/>

        <origin xyz="${caster_x} 0 ${caster_z}" rpy="0 0 0"/>

        <!-- Pour l'instant, roue libre -->
        <axis xyz="0 0 1"/>
    </joint>

    <!-- ================================================== -->
    <!-- CAPTEUR DE DISTANCE                               -->
    <!-- ================================================== -->
    <link name="lidar_link">
        <visual>
            <origin xyz="0 0 0"/>

            <geometry>
                <cylinder radius="0.025" length="0.02"/>
            </geometry>

            <material name="lidar_color">
                <color rgba="0.1 0.0 0.0 1.0"/>
            </material>
        </visual>
    </link>

    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>

        <origin xyz="0.25 0 0.066" rpy="0 0 0"/>
    </joint>

    <!-- ================================================== -->
    <!-- CAPTEUR GAZEBO                                    -->
    <!-- ================================================== -->
    <gazebo reference="lidar_link">
        <sensor name="front_lidar" type="gpu_lidar">

            <topic>/simulation/lidar_points</topic>

            <update_rate>10</update_rate>
            <always_on>true</always_on>
            <visualize>true</visualize>

            <lidar>
                <scan>
                    <horizontal>
                        <samples>3</samples>
                        <resolution>1</resolution>

                        <min_angle>-0.5</min_angle>
                        <max_angle>0.5</max_angle>
                    </horizontal>

                    <vertical>
                        <samples>3</samples>
                        <resolution>1</resolution>

                        <min_angle>-1.0472</min_angle>
                        <max_angle>0.0</max_angle>
                    </vertical>
                </scan>

                <range>
                    <min>0.05</min>
                    <max>15.0</max>
                    <resolution>0.01</resolution>
                </range>
            </lidar>

        </sensor>
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">

            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>

            <wheel_separation>0.33</wheel_separation>
            <wheel_radius>0.05</wheel_radius>

            <topic>/cmd_vel</topic>

            <odom_publish_frequency>30</odom_publish_frequency>

        </plugin>

    </gazebo>
</robot>